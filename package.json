{
  "name": "orca-deck",
  "version": "0.2.0",
  "private": true,
  "description": "Stream Deck Neo plugin: one key per Orca worktree with live agent status",
  "type": "module",
  "scripts": {
    "build": "node build.mjs && node scripts/build-profile.mjs",
    "link": "streamdeck link dev.orcadeck.sdPlugin",
    "pack": "npm run build && streamdeck pack dev.orcadeck.sdPlugin --output dist --force",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "dev": "node build.mjs --watch"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.1"
  },
  "license": "MIT"
}
